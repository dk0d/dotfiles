os:
  edit: "floaterm"
keybinding:
  universal:
    return: "<esc>"
gui:
  border: rounded
  nerdFontsVersion: '3'
  theme:
    activeBorderColor:
      - "{{ .theme.accent }}"
      - bold
    inactiveBorderColor:
      - "{{ .theme.surface2 }}"
    searchingActiveBorderColor:
      - "{{ .theme.accent_highlight }}"
    optionsTextColor:
      - "{{ .theme.blue }}"
    selectedLineBgColor:
      - "{{ .theme.selection }}"
    inactiveViewSelectedLineBgColor:
      - "{{ .theme.surface0 }}"
    cherryPickedCommitBgColor:
      - "{{ .theme.surface0 }}"
    cherryPickedCommitFgColor:
      - "{{ .theme.mauve }}"
    markedBaseCommitBgColor:
      - "{{ .theme.yellow }}"
    markedBaseCommitFgColor:
      - "{{ .theme.on_accent }}"
    unstagedChangesColor:
      - "{{ .theme.accent }}"
    defaultFgColor:
      - "{{ .theme.text }}"
git:
  diffRenderers:
    - colorArg: always
      command: delta --dark --paging=never --line-numbers --hyperlinks --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
