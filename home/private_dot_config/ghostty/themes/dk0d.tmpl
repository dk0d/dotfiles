# Matches the Catppuccin overrides in Neovim and tmux.
# Earthsong-inspired warmth and saturation, with copper accents over pure black.
background = {{ .theme.background }}
foreground = {{ .theme.text }}
cursor-color = {{ .theme.accent }}
cursor-text = {{ .theme.on_accent }}
selection-background = {{ .theme.selection }}
selection-foreground = {{ .theme.heading }}

palette = 0={{ .theme.surface0 }}
palette = 1={{ .theme.red }}
palette = 2={{ .theme.green }}
palette = 3={{ .theme.yellow }}
palette = 4={{ .theme.blue }}
# Keep magenta in the purple family so OpenCode's system agent colors stay distinct.
palette = 5={{ .theme.mauve }}
palette = 6={{ .theme.teal }}
palette = 7={{ .theme.text }}
palette = 8={{ .theme.overlay0 }}
palette = 9={{ .theme.bright_red }}
palette = 10={{ .theme.bright_green }}
palette = 11={{ .theme.bright_yellow }}
palette = 12={{ .theme.sky }}
palette = 13={{ .theme.bright_mauve }}
palette = 14={{ .theme.bright_teal }}
palette = 15={{ .theme.heading }}
