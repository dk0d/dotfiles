#!/bin/bash

# tmux.conf hash: {{ include "dot_tmux.conf.tmpl" | sha256sum }}
# TPM only clones plugins on prefix+I, so a listed-but-missing plugin stays
# silently absent. smart-splits needs its tmux half or <C-hjkl> never reaches nvim.
if [ -x ~/.tmux/plugins/tpm/bin/install_plugins ]; then
  echo "🔌 Installing tmux plugins"
  ~/.tmux/plugins/tpm/bin/install_plugins
fi
